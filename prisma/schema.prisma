generator client {
  provider        = "prisma-client" // or `prisma-client-js`
  output          = "../generated/prisma"
  engineType      = "client" // enable Prisma ORM without Rust
}
datasource db {
  provider = "postgresql"
}
model Usuario {
  id           String   @id @default(uuid())
  idHistorico  Int      @unique @default(0)
  name         String
  slug         String   @unique
  email        String   @unique
  password     String
  refreshToken RefreshToken?
  isBlocked    Boolean  @default(false) //block manual
  isPremium    Boolean  @default(false) 
  dtIniPremium DateTime?
  dtFimPremium DateTime?
  stripeCliId  String?  @unique
  stripeSubId  String?  @unique
  statusAss    Int      @default(1) // status stripe "inativo","ativo", "cancelado", "pendente"
  plano        Int      @default(0)  // status stripe "mensal", "anual", "semestral"
  refreshPasswordToken        String?   //TODO esqueci senha 
  refreshPasswordTokenExpires DateTime? //TODO esqueci senha
  conteudos    Conteudo[]
  categorias   Categoria[]
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  @@index([email, statusAss, isPremium])
}
model Conteudo {
  id             Int      @id @default(autoincrement())
  name           String?  @unique
  link           String?  //link do gif
  fonte          String? 
  linkext        String?  //video para redirecionar
  filename       String
  mimetype       String
  data           Bytes
  isTrend        Boolean  @default(false)
  categorias     Categoria[]
  userId         String
  user           Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
}

model Categoria {
  id             Int      @id @default(autoincrement())
  nome           String?  @unique
  name           String?  @unique
  descricao      String?
  isTrend        Boolean  @default(false)
  conteudos      Conteudo[]
  userId         String
  user           Usuario  @relation(fields: [userId], references: [id])
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model HistoricoUsuario {
  id             Int  @id @default(autoincrement())
  idHistUsuario  Int
  valorPago      Decimal @db.Decimal(10, 2)
  isBlocked      Boolean?
  isPremium      Boolean?
  dtIniPremium   DateTime?
  dtFimPremium   DateTime?
  statusAss      Int?
  plano          Int?
  createdAt      DateTime @default(now())
}

model RefreshToken {
  id            Int      @id @default(autoincrement())
  expiresIn     Int
  user          Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate:   Cascade)
  userId        String   @unique
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}